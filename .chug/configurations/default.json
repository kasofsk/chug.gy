{
  "version": 1,
  "name": "default",
  "configuration": {
    "version": 3,
    "image": "mcr.microsoft.com/devcontainers/go@sha256:2fe929afae562b8c50a28052aa6bc772e8045578fcc7b0508bb6da8935da3fb1",
    "workloads": {
      "work": {
        "runner": "Agent",
        "prompt": {
          "path": ".chug/prompts/work.md"
        },
        "worker": {
          "mode": {
            "type": "SingleAgent",
            "agent": "Claude",
            "arguments": []
          },
          "setup": [
            "echo \"GOCACHE=${TMPDIR:-/tmp}/go-build\" >> \"$CHUG_ENV\"",
            "echo \"GOMODCACHE=${TMPDIR:-/tmp}/go-mod\" >> \"$CHUG_ENV\"",
            "go mod download"
          ],
          "files": []
        },
        "authority": {
          "credentials": [
            "claude-code"
          ]
        }
      },
      "checks": {
        "runner": "Commands",
        "commands": [
          "test -z \"$(gofmt -l .)\"",
          "go vet ./...",
          "go test ./..."
        ],
        "worker": {
          "setup": [
            "echo \"GOCACHE=${TMPDIR:-/tmp}/go-build\" >> \"$CHUG_ENV\"",
            "echo \"GOMODCACHE=${TMPDIR:-/tmp}/go-mod\" >> \"$CHUG_ENV\"",
            "go mod download"
          ],
          "files": []
        }
      },
      "review": {
        "runner": "Agent",
        "purpose": "Review",
        "reevaluate": "OnChange",
        "prompt": {
          "path": ".chug/prompts/review.md"
        },
        "worker": {
          "mode": {
            "type": "SingleAgent",
            "agent": "Claude",
            "arguments": []
          },
          "setup": [
            "echo \"GOCACHE=${TMPDIR:-/tmp}/go-build\" >> \"$CHUG_ENV\"",
            "echo \"GOMODCACHE=${TMPDIR:-/tmp}/go-mod\" >> \"$CHUG_ENV\"",
            "go mod download"
          ],
          "files": []
        },
        "authority": {
          "credentials": [
            "claude-code"
          ]
        }
      },
      "workflow-run-work": {
        "runner": "Commands",
        "commands": [
          "go run ./tools/workflowrun --repo kasofsk/chug.gy --outcome success"
        ],
        "worker": {
          "setup": [
            "echo \"GOCACHE=${TMPDIR:-/tmp}/go-build\" >> \"$CHUG_ENV\"",
            "echo \"GOMODCACHE=${TMPDIR:-/tmp}/go-mod\" >> \"$CHUG_ENV\"",
            "go mod download"
          ],
          "files": []
        },
        "authority": {
          "credentials": [
            "chuggy.github-workflow-runs"
          ]
        }
      },
      "workflow-run": {
        "runner": "Commands",
        "commands": [
          "go run ./tools/workflowrun --repo kasofsk/chug.gy --outcome success"
        ],
        "worker": {
          "setup": [
            "echo \"GOCACHE=${TMPDIR:-/tmp}/go-build\" >> \"$CHUG_ENV\"",
            "echo \"GOMODCACHE=${TMPDIR:-/tmp}/go-mod\" >> \"$CHUG_ENV\"",
            "go mod download"
          ],
          "files": []
        },
        "authority": {
          "credentials": [
            "chuggy.github-workflow-runs"
          ]
        }
      }
    },
    "plans": {
      "standard": [
        {
          "name": "checks",
          "evaluators": [
            "checks"
          ]
        },
        {
          "name": "review",
          "evaluators": [
            "review"
          ]
        }
      ],
      "workflow-proof": [
        {
          "name": "checks",
          "evaluators": [
            "checks"
          ]
        },
        {
          "name": "workflow-run",
          "evaluators": [
            "workflow-run"
          ]
        }
      ]
    },
    "finalizers": {
      "stacked": {
        "finalization": {
          "kind": "GitMerge",
          "mode": "PullRequestMerge",
          "policy": "Stacked"
        }
      }
    },
    "defaults": {
      "work": "work",
      "evaluation": "standard",
      "finalization": "stacked"
    }
  }
}
